{
  "name": "deadzone-outbreak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "server": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:production": "node tests/production.mjs",
    "test:models": "node tests/models-browser.mjs",
    "test:knife-reference": "node tests/knife-reference-browser.mjs",
    "test:features": "node tests/features-browser.mjs",
    "format": "prettier --write src shared server scripts tests *.js *.json *.html README.md"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
